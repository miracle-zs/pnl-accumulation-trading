[Unit]
Description=15-minute periodic review trading service (Binance USDⓈ-M Futures)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=10min
StartLimitBurst=5

[Service]
Type=exec
User=pnl-trader
Group=pnl-trader
WorkingDirectory=/opt/pnl-accumulation-trading
EnvironmentFile=/opt/pnl-accumulation-trading/.env
StateDirectory=pnl-trader
StateDirectoryMode=0700
ExecStart=/opt/pnl-accumulation-trading/.venv/bin/pnl-trader run
Restart=on-failure
RestartSec=10s
TimeoutStopSec=60s
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
