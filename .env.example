# Local CLI runs read exported variables; source a copy of this file or export them.
# For systemd, set PNL_DATA_DIR=/var/lib/pnl-trader.
# .env is ignored by Git; never commit it.

# Runtime settings. The systemd service loads the project-root .env file.
PNL_DATA_DIR=./var
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional. Sends a Server酱 alert when an entire review round fails.
SERVERCHAN_SENDKEY=
