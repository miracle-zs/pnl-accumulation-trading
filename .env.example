# Copy to .env for a local run or systemd deployment.
# .env is ignored by Git; never commit it.

# Runtime settings. The systemd service loads the project-root .env file.
PNL_DATA_DIR=./var
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional. Sends a Server酱 alert when an entire review round fails.
SERVERCHAN_SENDKEY=

# For local research scripts only.
CMC_API_KEY=
