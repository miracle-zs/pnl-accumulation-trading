# Copy to a local service configuration and fill only reviewed values.
# Never commit .env or place API secrets in this file.

# Local settings for `pnl-trader run` and `pnl-trader validate-config`.
# `run` also requires Binance API credentials from environment or systemd credentials.
PNL_ASSET_CLASSIFICATIONS=
PNL_DATA_DIR=./var

# Optional. Sends a Server酱 alert when an entire review round fails.
SERVERCHAN_SENDKEY=

# For local research scripts only.
CMC_API_KEY=
